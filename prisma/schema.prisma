generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(320)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  createdAt    DateTime   @default(now()) @map("created_at")
  urls         ShortUrl[]

  @@map("users")
}

model ShortUrl {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  code       String   @unique @db.VarChar(32)
  targetUrl  String   @map("target_url") @db.VarChar(2048)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clicks     Click[]

  @@index([userId, createdAt])
  @@map("short_urls")
}

model Click {
  id         String   @id @default(uuid()) @db.Uuid
  shortUrlId String   @map("short_url_id") @db.Uuid
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  referer    String?  @db.VarChar(2048)
  createdAt  DateTime @default(now()) @map("created_at")
  shortUrl   ShortUrl @relation(fields: [shortUrlId], references: [id], onDelete: Cascade)

  @@index([shortUrlId, createdAt])
  @@map("clicks")
}
