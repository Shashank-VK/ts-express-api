# Application
NODE_ENV=development
PORT=3000

# A random value of at least 32 characters. Never commit the real secret.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1h

# PostgreSQL (the docker-compose service uses these same defaults)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/url_shortener?schema=public

# Comma-separated browser origins, or * for a public API client.
CORS_ORIGIN=http://localhost:3000
